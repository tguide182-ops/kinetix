{
  "name": "mediaforge-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "MediaForge Downloader \u2014 privacy-first media detection and download manager Chrome extension (Manifest V3).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-manifest.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify",
    "clean": "rm -rf dist",
    "e2e": "node e2e/run.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
