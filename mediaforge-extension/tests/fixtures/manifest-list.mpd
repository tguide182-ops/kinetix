<?xml version="1.0"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT8S">
  <Period>
    <AdaptationSet mimeType="video/mp4">
      <Representation id="1" bandwidth="1000000" width="1280" height="720">
        <BaseURL>video/</BaseURL>
        <SegmentList timescale="1" duration="4">
          <Initialization sourceURL="init.mp4" range="0-499"/>
          <SegmentURL media="s1.m4s"/>
          <SegmentURL media="s2.m4s" mediaRange="500-999"/>
        </SegmentList>
      </Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4">
      <Representation id="2" bandwidth="96000">
        <BaseURL>audio.mp4</BaseURL>
        <SegmentBase indexRange="700-900"><Initialization range="0-699"/></SegmentBase>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
